# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA envie o arquivo .env para o GitHub.

# Chave usada para assinar a sessão (login do painel). Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Banco de dados. Em desenvolvimento, deixe vazio para usar SQLite (instance/barbearia.db).
# Em produção (Render), use a URL do PostgreSQL.
DATABASE_URL=

# Login do painel do barbeiro (/admin)
ADMIN_USUARIO=barbeiro
ADMIN_SENHA=troque-esta-senha

# Dados da barbearia exibidos no site
BARBEARIA_NOME=Charme Chave
BARBEARIA_ENDERECO=Rua Bailão, 215 - Jardim Palmares, São Paulo - SP, 02328-060
BARBEARIA_TELEFONE=(11) 95235-3041
BARBEARIA_WHATSAPP=5511952353041
# Deixe vazio para não exibir link de Instagram
BARBEARIA_INSTAGRAM=_fabiocortes
# 1 = mostra no rodapé que a barbearia é fictícia (projeto acadêmico); 0 = esconde
BARBEARIA_FICTICIA=0
